{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": ["${workspaceFolder}/.venv/Lib/site-packages"],
  // Terminals aktivieren .venv selbst (Profil unten) - die Python-Erweiterung soll das nicht
  // zusätzlich tun, sonst hängt sie an einer früher ausgewählten, inzwischen gelöschten Umgebung.
  "python.terminal.activateEnvironment": false,
  "terminal.integrated.profiles.windows": {
    "PowerShell (.venv)": {
      "source": "PowerShell",
      "args": ["-NoExit", "-Command", "if (Test-Path .\\.venv\\Scripts\\Activate.ps1) { . .\\.venv\\Scripts\\Activate.ps1 }"]
    }
  },
  "terminal.integrated.defaultProfile.windows": "PowerShell (.venv)"
}
